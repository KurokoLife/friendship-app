# Sent with every page of the web app (Cloudflare reads this file).
# Stops other sites from showing Limen inside a frame, stops browsers from
# guessing file types, keeps the address private when leaving the site, and
# switches off device features the app never uses.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
